# Vapi API key — obtain from https://dashboard.vapi.ai
VAPI_API_KEY=your-vapi-api-key-here

# Vapi Public Key + Assistant ID — used by the /test browser voice client.
# Client-safe values (the SDK Public Key is designed to be exposed in browsers).
# Set these on Railway (Variables tab) or here for local dev.
VAPI_PUBLIC_KEY=your-vapi-public-key-here
VAPI_ASSISTANT_ID=your-vapi-assistant-id-here

# Optional: override the database path (defaults to ./patients.db)
# DATABASE_URL=sqlite:///./patients.db

# Optional: set to "true" during local dev for verbose logging
DEBUG=false
